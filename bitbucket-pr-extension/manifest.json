{
  "manifest_version": 3,
  "name": "Bitbucket PR Tracker",
  "version": "1.0.0",
  "description": "Tracks open Bitbucket Pull Requests and shows the active count on the extension badge icon.",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://api.bitbucket.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bitbucket Pull Requests",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
